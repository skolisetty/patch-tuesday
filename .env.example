# Copy to .env at the repo root (git-ignored) and fill in what you use. Every value may stay
# empty: the game then runs with template reasons, and BAND and Telem stay off.
# The game loads .env itself; never paste a key on a command line.

# Optional. Not needed: the pipeline uses the NVD bulk year feeds.
NVD_API_KEY=

# One-sentence agent reasons through an OpenAI-compatible endpoint. Empty LLM_API_KEY = templates.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_REASONS=0 forces template reasons even with a key.
LLM_REASONS=

# BAND event mirror: needs a remote AGENT key (band_a_...). Off unless BAND_ENABLED=1.
BAND_ENABLED=0
BAND_API_KEY=
BAND_CHAT_ID=
# Budget: posts per rolling hour (default 120) and per server process (default 300).
BAND_MAX_PER_HOUR=
BAND_MAX_EVENTS=

# BAND "Call for backup": a Coach agent analyses the Blue team mid-match and, when a human in the
# BAND room says yes, calls in a specialist agent. Needs BAND_ENABLED=1 and everything below that
# scripts/band_setup.py writes. Run:  python scripts/band_setup.py   (see docs/BAND.md)
# Your BAND USER key (band_u_...). Only band_setup.py reads it, to register the seven agents.
BAND_USER_API_KEY=
# 0 switches "Call for backup" off while the highlights mirror above stays on.
BAND_BACKUP=
# The room "Patch Tuesday - Blue team" (written by band_setup.py).
BAND_BLUE_CHAT_ID=
# Agent keys (band_a_...), one per agent (written by band_setup.py; BAND shows a key once).
BAND_KEY_COACH=
BAND_KEY_TRIAGE=
BAND_KEY_PATCHER=
BAND_KEY_HUNTER=
BAND_KEY_RESPONDER=
BAND_KEY_HARDENER=
BAND_KEY_SENTINEL=
# The same agents' ids (not secret; written by band_setup.py; used for mentions and for joining the room).
BAND_ID_COACH=
BAND_ID_TRIAGE=
BAND_ID_PATCHER=
BAND_ID_HUNTER=
BAND_ID_RESPONDER=
BAND_ID_HARDENER=
BAND_ID_SENTINEL=
# The tick Coach analyses the team at (default 40).
BAND_BACKUP_TICK=
# Ticks Coach waits for a human's reply (default 15).
BAND_BACKUP_WAIT_TICKS=
# 0 = with no reply Coach stands down; anything else = Coach calls in its own pick (default).
BAND_BACKUP_AUTO=
# Seconds between two posts in the room (default 3).
BAND_TEAM_MIN_INTERVAL=
# Seconds between two reads of Coach's inbox while a match runs (default and minimum 2.5).
BAND_TEAM_POLL_SECONDS=
# Budget: room posts per rolling hour (default 200) and per server process (default 1000).
BAND_TEAM_MAX_PER_HOUR=
BAND_TEAM_MAX_POSTS=
# Test only, leave empty: comma-separated BAND ids whose messages count like a human's.
BAND_TRUSTED_SENDER_IDS=
# Rehearsal only: 1 runs the Coach flow with no BAND at all (nobody can reply; Coach decides).
PT_BACKUP_OFFLINE=

# Telem intel for the blue Hunter's INTEL move. Off unless TELEM_ENABLED=1.
TELEM_ENABLED=0
TELEM_API_KEY=
# Budget: searches per match (default 3) and per server process (default 10).
TELEM_MAX_PER_MATCH=
TELEM_MAX_PER_PROCESS=

# Extra browser origins allowed to drive the server (comma-separated), e.g. a LAN address.
# localhost / 127.0.0.1 on ports 5173 and 8000 are always allowed.
PT_ALLOWED_ORIGINS=
