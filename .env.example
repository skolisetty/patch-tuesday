# Copy to .env at the repo root (git-ignored) and fill in what you use. Every value may stay
# empty: the game then runs with template reasons, and BAND and Telem stay off.
# The game loads .env itself; never paste a key on a command line.

# Optional. Not needed: the pipeline uses the NVD bulk year feeds.
NVD_API_KEY=

# One-sentence agent reasons through an OpenAI-compatible endpoint. Empty LLM_API_KEY = templates.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_REASONS=0 forces template reasons even with a key.
LLM_REASONS=

# BAND event mirror: needs a remote AGENT key (band_a_...). Off unless BAND_ENABLED=1.
BAND_ENABLED=0
BAND_API_KEY=
BAND_CHAT_ID=
# Budget: posts per rolling hour (default 120) and per server process (default 300).
BAND_MAX_PER_HOUR=
BAND_MAX_EVENTS=

# Telem intel for the blue Hunter's INTEL move. Off unless TELEM_ENABLED=1.
TELEM_ENABLED=0
TELEM_API_KEY=
# Budget: searches per match (default 3) and per server process (default 10).
TELEM_MAX_PER_MATCH=
TELEM_MAX_PER_PROCESS=

# Extra browser origins allowed to drive the server (comma-separated), e.g. a LAN address.
# localhost / 127.0.0.1 on ports 5173 and 8000 are always allowed.
PT_ALLOWED_ORIGINS=
